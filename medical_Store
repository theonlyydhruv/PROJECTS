# MySql Connection 
import mysql.connector 
from datetime import date 
 
try: 
    db = mysql.connector.connect( 
        host='localhost', 
        user='root', 
        password='011208', 
        database='medical_store' 
    ) 
    cur = db.cursor() 
except mysql.connector.Error as err: 
    print("Database connection failed:", err) 
    exit() 
# Database 
def inital_database(): 
    try: 
        cur.execute(""" 
        CREATE TABLE IF NOT EXISTS medicines ( 
            med_id INT AUTO_INCREMENT PRIMARY KEY, 
            name VARCHAR(100), 
            batch_no VARCHAR(50), 
            price FLOAT, 
            quantity INT, 
            expiry DATE 
        ) 
        """) 
        cur.execute(""" 
        CREATE TABLE IF NOT EXISTS sales ( 
            sale_id INT AUTO_INCREMENT PRIMARY KEY, 
            med_id INT, 
            qty_sold INT, 
            sale_date DATE, 
            FOREIGN KEY (med_id) REFERENCES medicines(med_id) 
        ) 
        """) 
        db.commit() 
    except Exception as e: 
        print("Error initializing database:", e) 
# Add Medicine 
def add_medicine(): 
    try: 
        print("\nAdd New Medicine") 
        name = input("Medicine Name: ") 
        batch = input("Batch Number: ") 
        price = float(input("Price per unit: ")) 
        qty = int(input("Quantity: ")) 
        exp = input("Expiry Date (YYYY-MM-DD): ") 
         
        cur.execute("INSERT INTO medicines VALUES (NULL, %s, %s, %s, %s, %s)",  
                    (name, batch, price, qty, exp)) 
        db.commit() 
        print("Medicine added successfully.") 
    except Exception as e: 
        print("Error adding medicine:", e) 
# View Stock 
def view_stock(): 
    try: 
        print("\nCurrent Medicine Stock:") 
        cur.execute("SELECT * FROM medicines") 
        records = cur.fetchall() 
        if records: 
            print("ID | Name | Batch | Price | Qty | Expiry") 
            for row in records: 
                print(row[0], "|", row[1], "|", row[2], "|", row[3], "|", row[4], 
"|", row[5]) 
        else: 
            print("No medicines found.") 
    except Exception as e: 
        print("Error showing stock:", e) 
# Sell Medicine 
def sell_medicine(): 
     
    try: 
        print("\nSell Medicine") 
        name = input("Enter medicine name: ").strip() 
         
        cur.execute("SELECT * FROM medicines WHERE name = %s", (name,)) 
        records = cur.fetchall() 
 
        if not records: 
            print("No medicine found with that name.") 
            return 
        elif len(records) == 1: 
            selected = records[0] 
        else: 
            print("Multiple records found:") 
            print("ID | Batch | Price | Qty | Expiry") 
            for row in records: 
                print(row[0], "|", row[2], "|", row[3], "|", row[4], "|", row[5]) 
            selected_id = int(input("Enter the medicine ID to sell: ")) 
            selected = None 
            for row in records: 
                if row[0] == selected_id: 
                    selected = row 
                    break 
            if not selected: 
                print("Invalid medicine ID.") 
                return 
         
        print("Available Quantity:", selected[4]) 
        choice = input("1. Sell specific quantity\n2. Sell all stock\nChoose option (1 or 2): ") 
         
        if choice == '1': 
            qty = int(input("Enter quantity to sell: ")) 
            if qty > selected[4]: 
                print("Not enough stock.") 
                return 
        elif choice == '2': 
            qty = selected[4] 
        else: 
            print("Invalid option.") 
            return 
 
        total_price = qty * selected[3] 
        print("Total bill: ₹", total_price) 
        confirm = input("Confirm sale? (y/n): ").lower() 
        if confirm == 'y': 
            cur.execute("UPDATE medicines SET quantity = quantity - %s WHERE med_id = %s", (qty, selected[0])) 
            cur.execute("INSERT INTO sales VALUES(NULL, %s, %s, %s)", (selected[0], 
qty, date.today())) 
            db.commit() 
            print("Sale completed.") 
        else: 
            print("Sale cancelled.") 
    except Exception as e: 
        print("Error while selling:", e) 
# Delete Expired Medicines 
def delete_expired(): 
    try: 
        print("\nDeleting expired medicines...") 
        cur.execute("DELETE FROM medicines WHERE expiry < %s", (date.today(),)) 
        db.commit() 
        print(cur.rowcount, "expired medicines deleted.") 
    except Exception as e: 
        print("Error deleting expired medicines:", e) 
# Main Function 
def main(): 
    inital_database() 
    while True: 
        print("\n--- Medical Store Menu ---") 
        print("1. Add Medicine") 
        print("2. View Stock") 
        print("3. Sell Medicine") 
        print("4. Delete Expired Medicines") 
        print("5. Exit") 
        choice = input("Enter your choice (1-5): ") 
        if choice == '1': 
            add_medicine() 
        elif choice == '2': 
            view_stock() 
        elif choice == '3': 
            sell_medicine() 
        elif choice == '4': 
            delete_expired() 
        elif choice == '5': 
            print("Exiting program.") 
            break 
        else: 
            print("Invalid choice. Try again.") 
main() 
 
 
